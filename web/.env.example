# Copy to .env.local. Never commit real values.
# Mock layer (sample data). Defaults to true until the backend exists. Set to "false" for live API.
NEXT_PUBLIC_USE_MOCKS=true
# FastAPI base URL serving GET /metrics/{metric}
NEXT_PUBLIC_API_URL=http://localhost:8000
# Supabase (anon key only; RLS protects data). Leave empty to disable auth UI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
